vec3 toSrgb(vec3 r2020) {
    vec3 lin = vec3(
        r2020.r < 0.08145 ? r2020.r / 4.5 : pow((r2020.r + 0.0993) / 1.0993, 1.0 / 0.45),
        r2020.g < 0.08145 ? r2020.g / 4.5 : pow((r2020.g + 0.0993) / 1.0993, 1.0 / 0.45),
        r2020.b < 0.08145 ? r2020.b / 4.5 : pow((r2020.b + 0.0993) / 1.0993, 1.0 / 0.45)
    );
    vec3 xyz = vec3(
        0.63697360*lin.r + 0.14462057*lin.g + 0.16885575*lin.b,
        0.26270669*lin.r + 0.67799807*lin.g + 0.05929524*lin.b,
        0.02807269*lin.g + 1.06098508*lin.b
    );
    vec3 ls = vec3(
         3.2404542*xyz.x - 1.5371385*xyz.y - 0.4985314*xyz.z,
        -0.9692660*xyz.x + 1.8760108*xyz.y + 0.0415560*xyz.z,
         0.0556434*xyz.x - 0.2040259*xyz.y + 1.0572252*xyz.z
    );
    return vec3(
        ls.r <= 0.0031308 ? ls.r * 12.92 : 1.055 * pow(ls.r, 1.0/2.4) - 0.055,
        ls.g <= 0.0031308 ? ls.g * 12.92 : 1.055 * pow(ls.g, 1.0/2.4) - 0.055,
        ls.b <= 0.0031308 ? ls.b * 12.92 : 1.055 * pow(ls.b, 1.0/2.4) - 0.055
    );
}
