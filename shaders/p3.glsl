vec3 toSrgb(vec3 p3) {
    vec3 lin = vec3(
        p3.r <= 0.04045 ? p3.r / 12.92 : pow((p3.r + 0.055) / 1.055, 2.4),
        p3.g <= 0.04045 ? p3.g / 12.92 : pow((p3.g + 0.055) / 1.055, 2.4),
        p3.b <= 0.04045 ? p3.b / 12.92 : pow((p3.b + 0.055) / 1.055, 2.4)
    );
    vec3 xyz = vec3(
        0.48657095*lin.r + 0.26566769*lin.g + 0.19821729*lin.b,
        0.22897456*lin.r + 0.69173852*lin.g + 0.07928691*lin.b,
        0.04511338*lin.g + 1.04394437*lin.b
    );
    vec3 ls = vec3(
         3.2404542*xyz.x - 1.5371385*xyz.y - 0.4985314*xyz.z,
        -0.9692660*xyz.x + 1.8760108*xyz.y + 0.0415560*xyz.z,
         0.0556434*xyz.x - 0.2040259*xyz.y + 1.0572252*xyz.z
    );
    return vec3(
        ls.r <= 0.0031308 ? ls.r * 12.92 : 1.055 * pow(ls.r, 1.0/2.4) - 0.055,
        ls.g <= 0.0031308 ? ls.g * 12.92 : 1.055 * pow(ls.g, 1.0/2.4) - 0.055,
        ls.b <= 0.0031308 ? ls.b * 12.92 : 1.055 * pow(ls.b, 1.0/2.4) - 0.055
    );
}
